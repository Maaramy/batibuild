node_modules/
.expo/
dist/
web-build/
expo-env.d.ts

# Artefacts de build locaux (npm run android:apk / android:aab)
build/

# Native build outputs
android/app/build/
android/.gradle/
android/build/
android/local.properties
ios/build/
ios/Pods/
ios/*.xcworkspace/xcuserdata/
*.ipa
*.apk
*.aab

# Projet natif Android commité : permet `./gradlew assembleRelease` en local
# (build 100 % local, sans EAS ni cloud — voir MOBILE_BUILD.md).
# Après toute modification d'app.json (permissions, version, nom…), resynchroniser :
#   npm run android:prebuild   puis   npm run signing:apply
# iOS reste en CNG (régénéré par `expo prebuild` sur macOS).
ios/

# Secrets de signature — NE JAMAIS COMMITER
android/keystore/
android/keystore.properties
secrets/
*.jks
*.keystore
*.p12

# Exception : la clé DEBUG Android standard DOIT être présente dans le dépôt.
# android/app/build.gradle la déclare (storeFile file('debug.keystore')) et
# Gradle échoue sur :app:validateSigningDebug si elle manque sur un clone/CI
# vierge. Ce n'est pas un secret de production (alias androiddebugkey,
# mot de passe « android », clé publique du modèle Android officiel).
# Régénération automatique si absente : node scripts/ensure-debug-keystore.mjs
!android/app/debug.keystore

# Env
.env
.env.local
