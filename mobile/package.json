{
  "name": "batibuild-mobile",
  "version": "1.0.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "prebuild": "expo prebuild",
    "typecheck": "tsc --noEmit",
    "android:prebuild": "expo prebuild --platform android",
    "android:debug": "node scripts/build-android.mjs debug",
    "android:apk": "node scripts/build-android.mjs apk",
    "android:aab": "node scripts/build-android.mjs aab",
    "android:install": "node scripts/install-android.mjs",
    "android:clean": "node scripts/build-android.mjs clean",
    "android:preflight": "node scripts/preflight-android.mjs --repair",
    "android:verify": "node scripts/verify-artifact.mjs build/Batibuild-release.apk",
    "keystore:generate": "node scripts/generate-keystore.mjs",
    "keystore:debug": "node scripts/ensure-debug-keystore.mjs",
    "signing:apply": "node scripts/apply-signing.mjs"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~57.0.21",
    "expo-constants": "~57.0.17",
    "expo-dev-client": "~57.0.18",
    "expo-file-system": "~57.0.6",
    "expo-linking": "~57.0.9",
    "expo-sharing": "~57.0.18",
    "expo-splash-screen": "~57.0.8",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.3",
    "lucide-react-native": "^0.577.0",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-svg": "15.15.4",
    "react-native-webview": "13.16.1"
  },
  "devDependencies": {
    "@types/react": "~19.2.0",
    "typescript": "~6.0.3"
  },
  "expo": {
    "doctor": {
      "appConfigFieldsNotSyncedCheck": {
        "enabled": false
      }
    }
  }
}
