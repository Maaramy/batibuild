{
  /*
   * PROJET DES TESTS — séparé de l'application pour la mémoire, pas pour
   * alléger la vérification.
   *
   * `tsconfig.app.json` compile l'application seule (aucun fichier de test) :
   * c'est le programme que `tsc -b` lance à chaque déploiement, et il frôlait
   * le plafond de 2 Go de la sandbox (charger les 169 fichiers de test coûtait
   * ~64 Mo). Aucun test n'est exclu du contrôle de type : il est simplement
   * exécuté dans CE projet, par `bun run typecheck` (projet « tests »).
   */
  "extends": "./tsconfig.app.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.tests.tsbuildinfo",
    /*
     * Le projet des tests tourne dans un environnement Node + Vitest : il a
     * besoin des globales de Vitest (`globals: true` dans vitest.config.ts)
     * en plus des types Vite hérités du projet application.
     */
    "types": ["vite/client", "vitest/globals", "node"]
  },
  "include": ["src/**/*.test.ts", "src/**/*.test.tsx"],
  "exclude": ["src/convex/**"]
}
