{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": false,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    /* Linting */
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true,
    "noPropertyAccessFromIndexSignature": false,
    // `baseUrl` est volontairement absent : TypeScript 7 (et donc `tsgo`, voir
    // scripts/harden-build-bins.mjs) l'a SUPPRIMÉ (erreur TS5102). `paths` se
    // résout sans lui, relativement à ce fichier.
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["src", "vly-toolbar-readonly.tsx"],
  /*
   * Le backend Convex est EXCLU du programme TypeScript du frontend.
   *
   * Le dossier src/convex a son propre projet TypeScript, qui couvre tous ses
   * fichiers, et il est typé à chaque push Convex (« Typechecking took … » :
   * un fichier Convex qui ne compile pas bloque la poussée). Le laisser dans ce
   * projet-ci faisait compiler du code serveur (bcryptjs, nodemailer, SDK
   * tiers) par le programme du navigateur : ~50 Mo de mémoire TypeScript en
   * plus, sur un build qui frôle déjà la limite de 2 Go de la sandbox.
   *
   * Les fichiers _generated restent bien typés ici : ils sont importés par le
   * frontend, et « exclude » ne s'applique qu'aux fichiers collectés via
   * « include », pas à ceux atteints par un import.
   */
  "exclude": ["src/convex/**"]
}
