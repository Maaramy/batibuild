{
  "compilerOptions": {
    /*
     * CACHE INCRÉMENTAL — activé explicitement.
     *
     * `tsBuildInfoFile` seul ne suffit pas : sans `incremental`, TypeScript
     * réécrit le fichier de build à chaque passage mais refait TOUTE
     * l'analyse. Mesuré ici : 65 s à chaque `tsc -p tsconfig.app.json`, même
     * deux fois de suite sans modifier un seul fichier. Avec `incremental`, un
     * second passage sans changement ne revérifie que ce qui a bougé.
     *
     * Aucune règle n'est assouplie : le premier passage reste complet. Le
     * fichier de cache vit dans node_modules/.tmp (ignoré par Git).
     */
    "incremental": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": false,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    /*
     * Types AMBIANTS limités à ce que le frontend utilise réellement.
     *
     * Sans ce champ, TypeScript charge TOUS les paquets `@types` installés
     * (node, nodemailer, jspdf, bcryptjs, three… et leurs dépendances) dans le
     * programme du navigateur, alors que le code les importe explicitement
     * quand il en a besoin (`three`, par exemple). Mesuré : −25 Mo et −26
     * fichiers de définitions sur un programme qui frôle la limite mémoire du
     * sandbox. `vite/client` reste requis pour `import.meta.env`.
     */
    "types": ["vite/client"],

    /* Linting */
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true,
    "noPropertyAccessFromIndexSignature": false,
    // `baseUrl` est volontairement absent : TypeScript 7 (et donc `tsgo`, voir
    // scripts/harden-build-bins.mjs) l'a SUPPRIMÉ (erreur TS5102). `paths` se
    // résout sans lui, relativement à ce fichier.
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["src", "vly-toolbar-readonly.tsx"],
  /*
   * Le backend Convex est EXCLU du programme TypeScript du frontend.
   *
   * Le dossier src/convex a son propre projet TypeScript, qui couvre tous ses
   * fichiers, et il est typé à chaque push Convex (« Typechecking took … » :
   * un fichier Convex qui ne compile pas bloque la poussée). Le laisser dans ce
   * projet-ci faisait compiler du code serveur (bcryptjs, nodemailer, SDK
   * tiers) par le programme du navigateur : ~50 Mo de mémoire TypeScript en
   * plus, sur un build qui frôle déjà la limite de 2 Go de la sandbox.
   *
   * Les fichiers _generated restent bien typés ici : ils sont importés par le
   * frontend, et « exclude » ne s'applique qu'aux fichiers collectés via
   * « include », pas à ceux atteints par un import.
   */
  "exclude": [
    "src/convex/**",
    /*
     * Les fichiers de test sont typés dans LEUR PROPRE projet
     * (`tsconfig.tests.json`), exécuté par `bun run typecheck tests` :
     * rien n'est retiré du contrôle de type, mais le programme de
     * l'application (celui que `tsc -b` compile à chaque déploiement) ne
     * charge plus les 169 fichiers de test et leurs dépendances de test.
     * Mesuré : −64 Mo et −13 s sur un build qui frôle la limite de 2 Go de
     * la sandbox. Un fichier de test n'entre PLUS dans ce programme.
     */
    "src/**/*.test.ts",
    "src/**/*.test.tsx"
  ]
}
